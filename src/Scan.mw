-- Walking an input with a machine, for a `Dfa` built at run time.
--
-- A lexer written by `@derive(Lexer)` does not come through here: it is
-- written out as code of its own, a function per state (see `Gen.mw`). This is
-- the scanner for the machinery used directly -- `compile` a list of patterns,
-- then `scan` with what it answers -- and it walks the tables instead.
--
-- Two things logos does are done here as well:
--
-- * **the input is read where it is.** logos scans a `&[u8]` and indexes it;
--   a Meadow string is bytes already, and `stringByteAt` is one load, so the
--   string is never taken apart into an array at all.
-- * **the text is cut only when somebody wants it.** logos's `Lexer::slice`
--   is called from a token's callback, so a token nobody asks about never
--   pays for its text. A skipped token -- whitespace, a comment -- is the
--   common case, and it costs nothing but the bytes it steps over.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Scythe.Automaton (Dfa, matchFrom, matchId, matchEnd)
use Lexed.*
use Error.*

-- A token and where it was found, in bytes.
@pub data Lexed a = Lexed a Int Int

@pub fun token l = match l with | Lexed t _ _ -> t
@pub fun start l = match l with | Lexed _ s _ -> s
@pub fun stop l = match l with | Lexed _ _ e -> e

-- Where a scan gave up, and on what.
@pub data Error = Unexpected Int

@pub fun errorAt e = match e with | Unexpected at -> at

-- `input` as tokens, or where it stopped making sense.
--
-- `skip` is the token numbers to drop -- whitespace, comments -- and `make`
-- builds a token from its number and the text that matched it.
@pub fun scan d skip make input =
  scanFrom d skip make input (stringByteLength input) 0 []

fun scanFrom d skip make (input : String) (n : Int) (at : Int) sofar =
  if at >= n then Ok sofar
  else
    let r = matchFrom d input at in
    let id = matchId r in
    let upto = matchEnd r in
    -- A pattern that matches nothing at all would leave the scan where it is,
    -- so it counts as no match: better an error than a loop.
    if id < 0 or upto <= at then Err (Unexpected at)
    else if skipped skip id 0 then scanFrom d skip make input n upto sofar
    else
      -- The only place the text is cut, and only for a token that is kept.
      let text = stringSlice input at upto in
      scanFrom d skip make input n upto (V.pushBack sofar (Lexed (make id text) at upto))

-- The tokens of `input` one at a time, into `f acc token start stop`, without
-- keeping them: logos's `Lexer`, which is an iterator, rather than a list
-- made of it. Where nothing needs every token at once -- counting, checking,
-- a parser that reads as it goes -- this is the scan without the collection.
@pub fun foldScan d skip make f acc input =
  foldFrom d skip make f (stringByteLength input) input 0 acc

fun foldFrom d skip make f (n : Int) (input : String) (at : Int) acc =
  if at >= n then Ok acc
  else
    let r = matchFrom d input at in
    let id = matchId r in
    let upto = matchEnd r in
    if id < 0 or upto <= at then Err (Unexpected at)
    else if skipped skip id 0 then foldFrom d skip make f n input upto acc
    else foldFrom d skip make f n input upto (f acc (make id (stringSlice input at upto)) at upto)

-- Whether `id` is one of the numbers to drop. There are a handful of these at
-- most -- one per `@skip` -- so a walk over them beats anything cleverer.
fun skipped skip (id : Int) (i : Int) : Bool =
  if i >= arrayLen skip then False
  else if arrayGet skip i == id then True
  else skipped skip id (i + 1)

-- --- what a derived lexer calls ------------------------------------------------
--
-- A derive writes its scanner out in full, but into the user's module, where
-- neither `Ok` nor `Lexed` nor `[]` need be in scope. These are the few pieces
-- it cannot write for itself.

@pub def noTokens = V.empty

@pub fun pushToken sofar t (at : Int) (upto : Int) = V.pushBack sofar (Lexed t at upto)

@pub fun scanned x = Ok x

@pub fun stuckAt (at : Int) = Err (Unexpected at)

-- What `next…` answers: the token found, and where; or that there is none
-- left.
@pub fun found t (at : Int) (upto : Int) = Ok (Just (Lexed t at upto))

@pub fun ended () = Ok None

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)
use Scythe.Automaton (compile)
use Scythe.Regex (parse)
use Scythe.Regex.Re.*

fun table patterns =
  compile (V.map (\p -> match p with | (id, text) ->
      (id, match parse text with | Ok re -> re | Err _ -> Empty)) patterns)

@test fun aScanIsEveryTokenInOrder () =
  let d = table [(0, "[0-9]+"), (1, "\\+"), (2, " +")] in
  let out = scan d #[2] (\id text -> (id, text)) "1 + 23" in
  assertEq (V.map token (unwrap out)) [(0, "1"), (1, "+"), (0, "23")]
    "three tokens, no spaces"

@test fun whatMatchesNothingIsAnError () =
  let d = table [(0, "[0-9]+")] in
  assertEq (scan d #[] (\id text -> id) "1?") (Err (Unexpected 1)) "the `?`"

@test fun aTokenKnowsWhereItWas () =
  let d = table [(0, "[0-9]+"), (1, " +")] in
  let out = unwrap (scan d #[1] (\id text -> text) "12 345") in
  let a = assertEq (V.map start out) [0, 3] "where each began" in
  assertEq (V.map stop out) [2, 6] "and where each ended"

@test fun anEmptyInputIsNoTokens () =
  let d = table [(0, "[0-9]+")] in
  assertEq (scan d #[] (\id text -> id) "") (Ok []) "nothing"

@test fun theTextIsTheBytesThatMatched () =
  -- The slice comes out of the byte array, not out of the string again, so a
  -- token late in a long input costs no more than an early one.
  let d = table [(0, "[a-z]+"), (1, " +")] in
  let out = unwrap (scan d #[1] (\id text -> text) "alpha beta gamma") in
  assertEq (V.map token out) ["alpha", "beta", "gamma"] "each one's own bytes"

fun unwrap r = match r with | Ok v -> v | Err _ -> []
