-- A lexer for a small calculator, written by `@derive(Lexer)`.
--
-- Everything below the declaration -- the automaton, the scanner -- is written
-- while this package is compiled. Run it with `meadow run` from this
-- directory.

use logos (lexer!, token, start, stop, errorAt)
use Std.Collections.Vector as V

@derive(Lexer)
@skip("[ \t\r\n]+")
@skip("--[^\n]*")
data Token
  = @token("+") Plus
  | @token("-") Minus
  | @token("*") Star
  | @token("/") Slash
  | @token("=") Equals
  | @token("(") LParen
  | @token(")") RParen
  | @token("let") Let
  | @regex("[0-9]+(\\.[0-9]+)?") Number String
  | @regex("[a-zA-Z_][a-zA-Z0-9_]*") Ident String

def main =
  let input = "let rate = 2.5 * (x + 40) -- how much\n" in
  match lexToken input with
  | Ok ts -> println (show (V.map token ts))
  | Err e -> println "stopped at byte ${show (errorAt e)}"
