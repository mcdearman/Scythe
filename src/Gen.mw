-- `@derive(Lexer)`: reading a token declaration and writing its lexer.
--
-- This is the macro -- `@macro` below is what says so. It runs while the
-- package that wrote the declaration is
-- compiled, so everything expensive -- parsing the patterns, building the
-- automaton -- happens once, there, and what is left for run time is code
-- written for this one machine: a function per state.
--
-- What it reads is the declaration as written, attributes and all:
--
--     @derive(Lexer)
--     @skip(" +")
--     data Token
--       = @token("+") Plus
--       | @regex("[0-9]+") Number String
--
-- and what it writes beside it is `lexToken : String -> Result Error [Lexed Token]`
-- and `foldToken`, the same tokens one at a time.
-- A variant with a `String` field is given the text that matched it; one with
-- no fields is given nothing.

use Std.Macro (TokenTree, spaced, text, isPunct, isWord, inside, splitOn, fail)
use Std.Macro.TokenTree.*
use Std.Macro.Delim.*
use Std.Macro.Loc.*
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Scythe.Regex (parse)
use Scythe.Automaton (compile, dfaClassOf, dfaTrans, dfaAccepts, dfaClasses, dfaStates)

@macro
@pub fun lexer ts =
  match declaration ts with
  | Err why -> fail why
  | Ok (name, skips, variants) ->
      match patterns variants skips with
      | Err why -> fail why
      | Ok res -> [Code (written name skips variants (compile res))]

-- --- reading the declaration ---------------------------------------------------

-- The type's name, the patterns to skip, and the variants as they were written.
fun declaration ts =
  match V.toList (V.drop (dropUntilData ts) 1) with
  | Nil -> Err "there is no `data` here for a lexer to be made from"
  | Cons nameTok rest ->
      match word nameTok with
      | None -> Err "a `data` declaration with no name"
      | Just name ->
          let body = V.dropWhile (\t -> not (isPunct "=" t)) (V.fromList rest) in
          if V.isEmpty body then Err "a `data` declaration with no variants"
          else Ok (name, skipsOf ts, splitOn "|" (V.drop body 1))

fun dropUntilData ts = V.dropWhile (\t -> not (isWord "data" t)) ts

fun word t = match t with | Word w _ -> Just w | _ -> None

-- `@skip("…")` written above the declaration, in the order they appear.
fun skipsOf ts =
  let heading = V.takeWhile (\t -> not (isWord "data" t)) ts in
  attributeArgs heading "skip"

-- The text inside every `@name("…")` in `ts`.
fun attributeArgs ts name =
  V.foldl
    (\acc i ->
      if isWord name (V.getOr (Punct "" Nowhere) ts i) and isPunct "@" (V.getOr (Punct "" Nowhere) ts (i - 1)) then
        match literalIn (V.getOr (Punct "" Nowhere) ts (i + 1)) with
        | Just s -> V.pushBack acc s
        | None -> acc
      else acc)
    []
    (V.range 1 (V.len ts))

-- The string inside `( "…" )`.
fun literalIn t =
  match inside t with
  | None -> None
  | Just ts ->
      match V.toList ts with
      | Cons (Str s _) Nil -> Just s
      | _ -> None

-- --- the patterns, in the order the machine numbers them ----------------------

-- Every variant's pattern, then every `@skip`: the skipped ones come last so
-- that a token always beats whitespace when both could match.
fun patterns variants skips =
  match collect variants 0 [] with
  | Err why -> Err why
  | Ok res ->
      collectSkips skips (V.len variants) res

fun collect variants at sofar =
  if at >= V.len variants then Ok sofar
  else
    let v = V.getOr [] variants at in
    match patternOf v with
    | Err why -> Err why
    | Ok re -> collect variants (at + 1) (V.pushBack sofar (at, re))

fun collectSkips skips base sofar =
  V.foldl
    (\acc pair ->
      match acc with
      | Err why -> Err why
      | Ok res ->
          match pair with
          | (i, pattern) ->
              match parse pattern with
              | Err why -> Err "a `@skip` pattern that is not a pattern: ${why}"
              | Ok re -> Ok (V.pushBack res (base + i, re)))
    (Ok sofar)
    (V.zip (V.range 0 (V.len skips)) skips)

-- The variants written `@skip`, by number: matched like any other -- so they
-- compete for the longest match in the order they are declared -- and then
-- left out of what is lexed. A variant without it is a token, whitespace
-- included: what a lossless tree is built from.
fun skippedIds variants =
  V.filter (\i -> bareSkip (V.getOr [] variants i)) (V.range 0 (V.len variants))

-- Whether `v` says `@skip` with nothing after it -- the variant-level marker,
-- not the type-level `@skip("…")`, which is a pattern of its own.
fun bareSkip v =
  V.any
    (\i ->
      isWord "skip" (V.getOr (Punct "" Nowhere) v i)
        and isPunct "@" (V.getOr (Punct "" Nowhere) v (i - 1))
        and not (isGroup (V.getOr (Punct "" Nowhere) v (i + 1))))
    (V.range 1 (V.len v))

fun isGroup t = match inside t with | Just _ -> True | None -> False

-- A variant's pattern: `@token("…")` is text to match exactly, `@regex("…")`
-- is a pattern.
fun patternOf v =
  let literal = attributeArgs v "token" in
  let pattern = attributeArgs v "regex" in
  if not (V.isEmpty literal) then
    match parse (quoted (V.getOr "" literal 0)) with
    | Err why -> Err "a `@token` that cannot be matched: ${why}"
    | Ok re -> Ok re
  else if not (V.isEmpty pattern) then
    match parse (V.getOr "" pattern 0) with
    | Err why -> Err "a `@regex` that is not a pattern: ${why}"
    | Ok re -> Ok re
  else Err "`${ctorOf v}` says nothing about what it matches: give it a `@token` or a `@regex`"

-- Text as a pattern that matches exactly it.
fun quoted s =
  V.foldl (\acc b -> acc ++ escaped b) "" (V.fromArray (S.toBytes s))

fun escaped b =
  let c = S.fromBytes #[b] in
  if V.elem (toInt b) metaBytes then "\\${c}" else c

def metaBytes = [40, 41, 91, 93, 123, 125, 46, 42, 43, 63, 124, 94, 36, 92, 45]

-- --- writing the lexer ---------------------------------------------------------
--
-- What is written is logos's shape rather than a table and a loop over it:
--
-- * **a function per state.** State `s` is `scytheTokenS<s>`, which reads a
--   byte and calls the state it moves to, in tail position -- so a move is a
--   jump, and the machine is the program's control flow rather than data the
--   program consults. Nothing is looked up to learn where to go next.
-- * **a jump table per state.** Where a state goes is decided by the byte's
--   class, as a chain of `k == …` tests on one `Int`, which LLVM turns into a
--   `switch` -- and a dense `switch` into a jump table. Classes that go to the
--   same state share one arm.
-- * **one lookup table, packed.** A byte's class is one byte of a 256-byte
--   string. A state with an edge back to itself -- an identifier, a number, a
--   run of spaces -- is given one *bit* of a second table instead, which says
--   of each byte whether the state stays put on it: logos's fast loop, and its
--   trick of packing several of those tables into the bits of one. Seven to a
--   byte here, since a string is UTF-8 and a byte above 127 would not survive.
-- * **one word per match.** A state answers where the longest match ended and
--   which token it was as one `Int` (`packMatch`), so nothing is allocated
--   until a token is actually built.
--
-- Everything written has its arguments annotated: an unannotated number would
-- be passed as any `Num`, and see `tables` for the tables.

fun written name skips variants d =
  let t = "scythe${name}" in
  let dropped = skippedIds variants in
  let wide = dfaClasses d in
  let slots = loopSlots d in
  let packed = wide < 128 in
  let classes = if packed then "packBytes" else "readInts" in
  "use Scythe (packBytes, readInts, noTokens, pushToken, scanned, stuckAt, found, ended)

-- A byte's class: bytes no pattern tells apart share one.
def ${t}Classes = ${classes} \"${showArray (dfaClassOf d)}\"

-- For each state that loops, one bit: whether it stays where it is on a byte.
def ${t}Loops = packBytes \"${showIntArray (loopTable d slots)}\"

-- ${show (dfaStates d)} states, ${show wide} classes.
${S.join "\n" (V.map (\s -> stateFun t d slots packed s) (V.range 0 (dfaStates d)))}
-- Whether a match of this number is one to leave out: a variant written
-- `@skip`, or one of the type's own skipped patterns.
fun ${t}Skipped (id : Int) : Bool = id >= ${show (V.len variants)}${S.join "" (V.map (\i -> " or id == ${show i}") dropped)}

-- A token from its number and where it was.
fun ${t}Make (id : Int) (input : String) (at : Int) (upto : Int) =
  ${arms name variants (V.range 0 (V.len variants))}

fun ${t}Go ${tables packed} (input : String) (n : Int) (at : Int) sofar =
  if at >= n then scanned sofar
  else
    let r = ${t}S0 c l input n at 0 in
    let id = r % 65536 - 1 in
    let upto = r / 65536 in
    if id < 0 or upto <= at then stuckAt at
    else if ${t}Skipped id then ${t}Go c l input n upto sofar
    else ${t}Go c l input n upto (pushToken sofar (${t}Make id input at upto) at upto)

fun ${t}Fold f ${tables packed} (input : String) (n : Int) (at : Int) acc =
  if at >= n then scanned acc
  else
    let r = ${t}S0 c l input n at 0 in
    let id = r % 65536 - 1 in
    let upto = r / 65536 in
    if id < 0 or upto <= at then stuckAt at
    else if ${t}Skipped id then ${t}Fold f c l input n upto acc
    else ${t}Fold f c l input n upto (f acc (${t}Make id input at upto) at upto)

fun ${t}Next ${tables packed} (input : String) (n : Int) (at : Int) =
  if at >= n then ended ()
  else
    let r = ${t}S0 c l input n at 0 in
    let id = r % 65536 - 1 in
    let upto = r / 65536 in
    if id < 0 or upto <= at then stuckAt at
    else if ${t}Skipped id then ${t}Next c l input n upto
    else found (${t}Make id input at upto) at upto

-- Every token in `input`, or where it stopped making sense.
@pub fun lex${name} input =
  ${t}Go ${t}Classes ${t}Loops input (stringByteLength input) 0 noTokens

-- The tokens one at a time, into `f acc token start stop`, keeping none of
-- them: logos's `Lexer`, which is an iterator rather than a list.
@pub fun fold${name} f acc input =
  ${t}Fold f ${t}Classes ${t}Loops input (stringByteLength input) 0 acc

-- The token at byte `at` of `input`, past any skipped: logos's `Lexer::next`,
-- from wherever the caller says. What a lexer reading one part of a text with
-- these tokens and another part with other ones is made of -- logos's `bump`
-- and `morph`. `Ok None` at the end of the input.
@pub fun next${name} input (at : Int) =
  ${t}Next ${t}Classes ${t}Loops input (stringByteLength input) at
"

-- The tables every generated function takes, annotated: the class table is a
-- string of bytes where the classes fit in one, and numbers where they do not.
-- Written out rather than left to inference, because a state that never reads
-- the class table would otherwise be generic in it, and every call to it an
-- instantiation where one monomorphic function would do.
fun tables packed =
  if packed then "(c : String) (l : String)" else "(c : Array Int) (l : String)"

-- The states with an edge back to themselves, numbered: each is given the bit
-- `slot % 7` of loop table `slot / 7`. -1 for a state that does not loop.
fun loopSlots d =
  let wide = dfaClasses d in
  let trans = dfaTrans d in
  V.foldl
    (\acc s ->
      match acc with
      | (slots, next) ->
          if loops trans wide s then (V.pushBack slots next, next + 1)
          else (V.pushBack slots (0 - 1), next))
    ([], 0)
    (V.range 0 (dfaStates d))
    |> fst

fun loops trans wide s = V.any (\c -> arrayGet trans (s * wide + c) == s) (V.range 0 wide)

-- The loop tables, 256 bytes each, one after another.
fun loopTable d slots =
  let used = V.foldl (\m x -> if x + 1 > m then x + 1 else m) 0 slots in
  let tables = (used + 6) / 7 in
  V.concatMap (\tbl -> V.map (\b -> loopByte d slots tbl b) (V.range 0 256)) (V.range 0 tables)

-- Byte `b` of loop table `tbl`: a bit for each state in it that stays on `b`.
fun loopByte d slots tbl b =
  let wide = dfaClasses d in
  let trans = dfaTrans d in
  let cls = arrayGet (dfaClassOf d) b in
  V.foldl
    (\acc s ->
      let slot = V.getOr (0 - 1) slots s in
      if slot >= 0 and slot / 7 == tbl and arrayGet trans (s * wide + cls) == s
      then acc + pow2 (slot % 7)
      else acc)
    0
    (V.range 0 (V.len slots))

fun pow2 k = if k <= 0 then 1 else 2 * pow2 (k - 1)

-- State `s` as a function. It notes the match it makes, if it accepts; stays
-- on its loop bytes, if it has any; and otherwise dispatches on the class.
fun stateFun t d slots packed s =
  let accept = arrayGet (dfaAccepts d) s in
  let slot = V.getOr (0 - 1) slots s in
  let me = "${t}S${show s}" in
  let noted = if accept >= 0 then "i * 65536 + ${show (accept + 1)}" else "best" in
  let loop =
    if slot < 0 then ""
    else
      "    if bitAnd (toInt (stringByteAt l (${show (256 * (slot / 7))} + b))) ${show (pow2 (slot % 7))} != 0
    then ${me} c l input n (i + 1) here
    else\n" in
      let klass = if packed then "toInt (stringByteAt c b)" else "arrayGet c b" in
      "fun ${me} ${tables packed} (input : String) (n : Int) (i : Int) (best : Int) : Int =
  let here = ${noted} in
  if i >= n then here
  else
    let b = toInt (stringByteAt input i) in
${loop}${dispatch t d s klass}
"

-- Where `s` goes on each class but its own loop, grouped by where it goes.
fun dispatch t d s klass =
  let wide = dfaClasses d in
  let trans = dfaTrans d in
  let targets =
    V.foldl
      (\acc c ->
        let to = arrayGet trans (s * wide + c) in
        if to < 0 or to == s or V.elem to acc then acc else V.pushBack acc to)
      []
      (V.range 0 wide) in
    if V.isEmpty targets then "    here"
    else
      let arms =
        V.map
        (\to ->
          let cs = V.filter (\c -> arrayGet trans (s * wide + c) == to) (V.range 0 wide) in
          let test = S.join " or " (V.map (\c -> "k == ${show c}") cs) in
          "if ${test} then ${t}S${show to} c l input n (i + 1) here")
        targets in
        "    let k = ${klass} in\n    ${S.join "\n    else " arms}\n    else here"

-- `if id == 0 then Type.Plus else …`, and a token that takes the text is given
-- it. The last arm needs no test: the table answers with nothing else.
fun arms name variants ids =
  match V.toList ids with
  | Nil -> "${name}"
  | Cons _ _ ->
      V.foldl
      (\acc i ->
        let ctor = build name (V.getOr [] variants i) in
        if i + 1 == V.len ids then "${acc}${ctor}"
        else "${acc}if id == ${show i} then ${ctor} else ")
      ""
      ids

fun build name v =
  let ctor = ctorOf v in
  if takesText v then "(${name}.${ctor} (stringSlice input at upto))" else "${name}.${ctor}"

-- The variant's name: the first word that is not an attribute's.
fun ctorOf v =
  let after = V.dropWhile (\t -> not (isCtorStart v t)) v in
  match V.get after 0 with
  | Just t -> text t
  | None -> "?"

fun isCtorStart v t =
  match t with
  | Word w _ -> isUpper w and not (V.elem w (attributeNames v))
  | _ -> False

fun attributeNames v =
  V.foldl
    (\acc i ->
      if isPunct "@" (V.getOr (Punct "" Nowhere) v i) then
        match word (V.getOr (Punct "" Nowhere) v (i + 1)) with
        | Just w -> V.pushBack acc w
        | None -> acc
      else acc)
    []
    (V.range 0 (V.len v))

-- Whether the variant takes the text that matched it: it does when it has a
-- field, and `String` is the only field a lexer knows how to fill.
fun takesText v =
  let ctor = ctorOf v in
  V.any (\t -> isWord "String" t) (V.dropWhile (\t -> text t != ctor) v)

fun isUpper w =
  match S.byteAt w 0 with
  | Just b -> b >= 65 and b <= 90
  | None -> False

fun lower w =
  if S.isEmpty w then w
  else S.toLower (S.take w 1) ++ S.drop w 1

-- --- writing the table out -----------------------------------------------------

-- An array of numbers, as the text `readInts` reads back. A literal would be
-- the obvious thing to write and is the one thing that cannot be: see
-- `readInts` for why a table travels as a string.
fun showArray a = showIntArray (V.fromArray a)

fun showIntArray xs = S.join "," (V.map show xs)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)
use Scythe.Regex.Re.*

-- The declaration above, as the tokens a derive is given.
fun declared () =
  [Punct "@" Nowhere, Word "derive" Nowhere, Group Paren [Word "Lexer" Nowhere] Nowhere,
    Punct "@" Nowhere, Word "skip" Nowhere, Group Paren [Str " +" Nowhere] Nowhere,
    Word "data" Nowhere, Word "Token" Nowhere, Punct "=" Nowhere,
    Punct "@" Nowhere, Word "token" Nowhere, Group Paren [Str "+" Nowhere] Nowhere, Word "Plus" Nowhere,
    Punct "|" Nowhere,
    Punct "@" Nowhere, Word "regex" Nowhere, Group Paren [Str "[0-9]+" Nowhere] Nowhere, Word "Number" Nowhere, Word "String" Nowhere]

@test fun aDeclarationIsReadForItsNameAndVariants () =
  match declaration (declared ()) with
  | Err why -> assertTrue False why
  | Ok (name, skips, variants) ->
      let a = assertEq name "Token" "the type's name" in
      let b = assertEq skips [" +"] "what is skipped" in
      assertEq (V.len variants) 2 "two variants"

@test fun aVariantSaysWhatItMatchesAndWhetherItTakesTheText () =
  match declaration (declared ()) with
  | Err why -> assertTrue False why
  | Ok (_, _, variants) ->
      let plus = V.getOr [] variants 0 in
      let number = V.getOr [] variants 1 in
      let a = assertEq (ctorOf plus) "Plus" "the first constructor" in
      let b = assertEq (ctorOf number) "Number" "the second" in
      let c = assertTrue (not (takesText plus)) "a bare variant takes nothing" in
      assertTrue (takesText number) "one with a `String` field takes the text"

@test fun aTokenIsMatchedExactly () =
  -- `+` means a plus sign, not "one or more of what came before".
  assertEq (quoted "a+b") "a\\+b" "the meta characters are escaped"

@test fun aVariantWithNoPatternIsRefused () =
  match patternOf [Word "Plus" Nowhere] with
  | Err why -> assertTrue (S.contains "says nothing about what it matches" why) why
  | Ok _ -> assertTrue False "it should have been refused"

@test fun aPatternThatIsNotOneIsRefused () =
  match patternOf [Punct "@" Nowhere, Word "regex" Nowhere, Group Paren [Str "[a" Nowhere] Nowhere, Word "Bad" Nowhere] with
  | Err why -> assertTrue (S.contains "not a pattern" why) why
  | Ok _ -> assertTrue False "it should have been refused"

@test fun whatIsWrittenIsWhatItRunsOn () =
  match declaration (declared ()) with
  | Err why -> assertTrue False why
  | Ok (name, skips, variants) ->
      match patterns variants skips with
      | Err why -> assertTrue False why
      | Ok res ->
          let out = written name skips variants (compile res) in
          let a = assertTrue (S.contains "@pub fun lexToken input" out) "a function named for the type" in
          let b = assertTrue (S.contains "fun scytheTokenS0 " out and S.contains "packBytes" out) "a function per state, and a packed table" in
          let c = assertTrue (S.contains "Token.Plus" out) "a constructor with no text" in
          assertTrue (S.contains "(Token.Number (stringSlice input at upto))" out) "and one with it"

-- Nine patterns that each stay put on their own letter: nine looping states,
-- so the ninth's bit is in a second table, 256 bytes along.
@test fun moreLoopsThanOneTableHoldsSpillIntoTheNext () =
  let letters = V.range 97 106 in
  let d = compile (V.map (\b -> (b - 97, Star (Lit b))) letters) in
  let out = written "L" [] [] d in
  let a = assertTrue (S.contains "stringByteAt l (0 + b)" out) "the first table" in
  assertTrue (S.contains "stringByteAt l (256 + b)" out) "and the second"

-- 127 bytes told apart make 128 classes, which do not fit a byte of a string
-- below 128: the class table is written as numbers instead.
@test fun tooManyClassesForAByteAreKeptAsNumbers () =
  let d = compile (V.map (\b -> (b - 1, Lit b)) (V.range 1 128)) in
  let out = written "W" [] [] d in
  let a = assertTrue (S.contains "def scytheWClasses = readInts" out) "read as numbers" in
  assertTrue (S.contains "arrayGet c b" out) "and looked up in an array"

@test fun aFewClassesArePackedIntoAString () =
  let d = compile [(0, Lit 97), (1, Lit 98)] in
  let out = written "P" [] [] d in
  let a = assertTrue (S.contains "def scythePClasses = packBytes" out) "packed" in
  assertTrue (S.contains "toInt (stringByteAt c b)" out) "and read a byte at a time"

@test fun aVariantWrittenSkipIsMatchedAndLeftOut () =
  let space = [Punct "@" Nowhere, Word "regex" Nowhere, Group Paren [Str "[ ]+" Nowhere] Nowhere, Punct "@" Nowhere, Word "skip" Nowhere, Word "Space" Nowhere] in
  let plus = [Punct "@" Nowhere, Word "token" Nowhere, Group Paren [Str "+" Nowhere] Nowhere, Word "Plus" Nowhere] in
  let kept = [Punct "@" Nowhere, Word "regex" Nowhere, Group Paren [Str "[ ]+" Nowhere] Nowhere, Word "Space" Nowhere] in
  let a = assertEq (skippedIds [space, plus]) [0] "the one written `@skip`" in
  let b = assertEq (skippedIds [kept, plus]) [] "whitespace without it is a token" in
  assertEq (ctorOf space) "Space" "`skip` is not taken for the constructor"
