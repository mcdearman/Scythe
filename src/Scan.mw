-- Walking an input with a machine: what a generated lexer calls.
--
-- The scanner is the same for every token type -- the table is what differs --
-- so it lives here rather than being written out for each one. What a
-- generated lexer supplies is its table, which of its tokens are skipped, and
-- how to build a token from the number the table answers with.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*
use Std.Result.Result.*
use Logos.Automaton (Dfa, longestFrom, bytesOf)
use Lexed.*
use Error.*

-- A token and where it was found, in bytes.
@pub data Lexed a = Lexed a Int Int

@pub fun token l = match l with | Lexed t _ _ -> t
@pub fun start l = match l with | Lexed _ s _ -> s
@pub fun stop l = match l with | Lexed _ _ e -> e

-- Where a scan gave up, and on what.
@pub data Error = Unexpected Int

@pub fun errorAt e = match e with | Unexpected at -> at

-- `input` as tokens, or where it stopped making sense.
--
-- `skip` is the token numbers to drop -- whitespace, comments -- and `make`
-- builds a token from its number and the text that matched it.
@pub fun scan d skip make input =
  scanning d skip make input (bytesOf input) 0 []

fun scanning d skip make input bytes at sofar =
  if at >= V.len bytes then Ok sofar
  else
    let (id, upto) = longestFrom d bytes at in
    -- A pattern that matches nothing at all would leave the scan where it is,
    -- so it counts as no match: better an error than a loop.
    if id < 0 or upto <= at then Err (Unexpected at)
    else
      let text = S.slice input at upto in
      let kept = if V.elem id skip then sofar
                 else V.pushBack sofar (Lexed (make id text) at upto) in
      scanning d skip make input bytes upto kept

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)
use Logos.Automaton (compile)
use Logos.Regex (parse)
use Logos.Regex.Re.*

fun table patterns =
  compile (V.map (\p -> match p with | (id, text) ->
      (id, match parse text with | Ok re -> re | Err _ -> Empty)) patterns)

@test fun aScanIsEveryTokenInOrder () =
  let d = table [(0, "[0-9]+"), (1, "\\+"), (2, " +")] in
  let out = scan d [2] (\id text -> (id, text)) "1 + 23" in
  assertEq (V.map token (unwrap out)) [(0, "1"), (1, "+"), (0, "23")]
    "three tokens, no spaces"

@test fun whatMatchesNothingIsAnError () =
  let d = table [(0, "[0-9]+")] in
  assertEq (scan d [] (\id text -> id) "1?") (Err (Unexpected 1)) "the `?`"

@test fun aTokenKnowsWhereItWas () =
  let d = table [(0, "[0-9]+"), (1, " +")] in
  let out = unwrap (scan d [1] (\id text -> text) "12 345") in
  let a = assertEq (V.map start out) [0, 3] "where each began" in
  assertEq (V.map stop out) [2, 6] "and where each ended"

@test fun anEmptyInputIsNoTokens () =
  let d = table [(0, "[0-9]+")] in
  assertEq (scan d [] (\id text -> id) "") (Ok []) "nothing"

fun unwrap r = match r with | Ok v -> v | Err _ -> []
